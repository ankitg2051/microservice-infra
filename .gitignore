# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform state lock info
.terraform.tfstate.lock.info

# Terraform plan files
*tfplan*
planout

# Crash logs
crash.log
crash.*.log

# Sensitive/local variable files
*.secret.tfvars
*.local.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Example: allow explicitly selected override files
# !example_override.tf

# Terraform CLI configuration
.terraformrc
terraform.rc

# Optional Terraform graph output
# *.dot